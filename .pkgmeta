# BigWigs packager settings: builds ForeverGoalTracker-<version>.zip
# and uploads it to CurseForge when a version tag is pushed.
package-as: ForeverGoalTracker

# Use our hand-written changelog (instead of a list of commit messages)
# for the CurseForge file page, and keep it as-is inside the zip.
manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown

ignore:
  - README.md
  - .github
  - .gitignore
  - .pkgmeta
  - Media/logo.png
  - Media/minimap-source.png
  - Media/forever-source.png
  - Media/interests/*-source.*
  - ROADMAP.md
  - Screenshots
  - CLAUDE.md
  - tools
